<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
          "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- CMIO camera extensions run inside the system extension daemon and
         need no additional entitlements; sandboxing is applied by the
         system. Kept as a file so codesign gets an explicit (empty) set. -->
</dict>
</plist>
